  "test_name": "IPIP Big Five",
  "full_name": "International Personality Item Pool - Big Five Factor Markers",
  "language": "sv",
  "response_scale": {
    "type": "likert",
    "min": 1,
    "max": 5,
    "labels": {
      "1": "Stämmer inte alls",
